# Copy to .env and fill in. NEVER commit the real .env.
DATABASE_URL=postgres://goutreach:goutreach@localhost:5432/goutreach?sslmode=disable
HTTP_ADDR=:8080
# Public base URL used in open/click tracking links (and where the app is reached).
APP_URL=http://localhost:8080
# Claude API key for AI email generation.
ANTHROPIC_API_KEY=
# 32+ byte key for AES-256-GCM encryption of stored SMTP/IMAP + integration passwords.
ENCRYPTION_KEY=change-me-to-a-32-byte-random-string
# Secret for signing dashboard session JWTs.
JWT_SECRET=change-me

# "Sign in with Google" OAuth (optional). Create an OAuth client at
# console.cloud.google.com → APIs & Services → Credentials (type: Web app).
# Enable the Gmail API, and add the redirect URI: <APP_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to APP_URL + /api/oauth/google/callback if left blank.
GOOGLE_REDIRECT_URL=
